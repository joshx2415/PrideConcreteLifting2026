---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import type { FAQItem } from '../components/StructuredData.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  isHomepage?: boolean;
  ogImage?: string;
  structuredDataType?: 'business' | 'service';
  faqItems?: FAQItem[];
}

const {
  title,
  description = "Professional concrete lifting and soil stabilization services in Dallas-Fort Worth. Nearly 30 years of experience lifting driveways, sidewalks, pool decks, garage floors, and more. Free estimates.",
  isHomepage = false,
  ogImage = "/images/og-default.jpg",
  structuredDataType = 'business',
  faqItems = []
} = Astro.props;

const siteName = "Pride Concrete Lifting";
// N.B. The brand belongs in every <title> — the homepage most of all.
// It was once exempted via isHomepage, leaving our own name absent from
// the one page Google most associates with the brand.
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <!-- N.B. No meta keywords tag. Google has ignored it since 2009; its only
         modern function is to whisper "this site does 2012 SEO" to competitors
         and spam classifiers alike. Requiescat in pace. -->

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <!-- Business Information -->
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Dallas-Fort Worth" />
    
    <!-- N.B. Fonts are self-hosted (Fontsource, imported via global.css).
         No Google Fonts <link> here — it was render-blocking on every page. -->

    <!-- N.B. Alpine.js is bundled by the @astrojs/alpinejs integration.
         Do not re-add the CDN <script> here — two copies of Alpine racing
         to initialize the same directives is a goblin we have banished. -->

    <!-- Structured Data -->
    <StructuredData type={structuredDataType} title={title} description={description} image={ogImage} faqItems={faqItems} />
  </head>
  <body>
    <Nav isHomepage={isHomepage} />
    <slot />
    <Footer />
  </body>
</html>