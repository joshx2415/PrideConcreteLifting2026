---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Pride Concrete Lifting serves Dallas-Fort Worth with concrete lifting and soil stabilization."
>
  <div class="bg-white">
    <section class="flex items-center justify-center min-h-screen pt-20 pb-32">
      <div class="container px-6 mx-auto max-w-2xl text-center">
        <p class="mb-4 text-8xl font-bold text-pride-red">404</p>
        <h1 class="mb-4 text-3xl font-bold text-navy-900 lg:text-4xl">
          Looks Like This Page Has Sunk
        </h1>
        <p class="mb-8 text-lg text-gray-600">
          We couldn't find what you're looking for — but we can definitely find what's wrong with your concrete.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            href="/"
            class="inline-flex items-center px-6 py-3 text-lg font-bold text-white bg-pride-red rounded hover:bg-red-700 transition-colors"
          >
            <Icon name="fa-solid:home" class="w-5 h-5 mr-2" />
            Back to Home
          </a>
          <a
            href="tel:817-888-6254"
            class="inline-flex items-center px-6 py-3 text-lg font-semibold text-navy-900 bg-gray-100 rounded hover:bg-gray-200 transition-colors"
          >
            <Icon name="fa-solid:phone" class="w-5 h-5 mr-2 text-pride-red" />
            Call 817-888-6254
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
