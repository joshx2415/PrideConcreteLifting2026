---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets'; // <--- Import this
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.vue';
import Gallery from '../../components/Gallery.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => {
    // If we are in Production (Netlify), hide drafts.
    // If we are in Dev (npm run dev), show them so you can work on them!
    if (import.meta.env.PROD) {
        return data.draft !== true;
    }
    return true;
  });

  return services.map(service => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<BaseLayout 
  title={service.data.title}
  description={service.data.description}
  ogImage={service.data.heroImage?.src || "/images/logo.png"}
  structuredDataType="service"
  faqItems={service.data.faqItems || []}
>
  <div class="transition-colors duration-1000 bg-white">
    <section class="text-gray-700 mx-auto lg:w-3/4 lg:px-0 items-center pt-32">
      <div class="flex flex-col w-full mx-auto px-5 mb-2 text-left">
        <div class="mb-4">
          <Breadcrumbs items={[
            { label: "Services", href: "/#services" },
            { label: service.data.title.split('|')[0].trim() }
          ]} />
        </div>
        <h1 class="mb-2 text-3xl font-black tracking-tighter text-black lg:text-7xl md:text-4xl">
          {service.data.title}
        </h1>

        {service.data.heroImage && (
          <div class="flex flex-col items-start py-4 mx-auto lg:items-center md:flex-row">
            <div class="w-full mb-10 lg:w-5/6 lg:max-w-lg md:w-1/2">
              {/* FIX 2: Use Astro <Image /> component. It accepts the full object. */}
              <Image 
                src={service.data.heroImage} 
                alt={service.data.title}
                class="object-cover object-center shadow-md rounded"
                loading="eager" 
              />
            </div>
          </div>
        )}

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>

      </div>
    </section>

    {service.data.gallery && service.data.gallery.length > 0 && (
      <Gallery images={service.data.gallery} />
    )}

    <section>
      <div class="bg-navy-900 items-center py-12">
        <div class="flex flex-col w-full mb-4 text-left p-4 lg:text-center">
          <h2 id="contact" class="mb-2 text-3xl font-bold text-white tracking-tighter lg:text-5xl md:text-4xl">
            Send Us A Message
          </h2>
          <p class="mt-4 text-lg tracking-wide text-white">
            Let Us Know How We Can Help You
          </p>
          <p class="mb-8 md:w-1/2 md:px-10 mt-4 mx-auto text-lg leading-snug tracking-tight text-gray-300">
            Fill out the form below to get in contact with us! We can also be reached via email at:
            <span class="md:text-xl text-pride-red font-semibold">
              contact@prideconcretelifting.com</span> or via telephone at:
            <span class="md:text-xl text-pride-red font-semibold">
              <a href="tel:817-888-6254">817-888-6254</a>
            </span>.
          </p>
        </div>

        <ContactForm client:load />
      </div>
    </section>
  </div>

  <style is:global>
    .prose {
      color: #374151; /* gray-700 */
      line-height: 1.75;
    }

    /* Spacing between paragraphs */
    .prose p {
      margin-bottom: 1.5rem;
    }

    /* Headers */
    .prose h2 {
      color: #001f54; /* navy-900 */
      font-size: 1.5rem;
      font-weight: 700;
      margin-top: 2.5rem;
      margin-bottom: 1rem;
    }

    .prose h3 {
      color: #001f54; /* navy-900 */
      font-size: 1.25rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
    }

    /* Lists */
    .prose ul {
      list-style-type: disc;
      padding-left: 1.5rem; /* Indent bullets */
      margin-bottom: 1.5rem;
    }

    .prose li {
      margin-bottom: 0.5rem;
    }

    .prose li::marker {
      color: #c8102e; /* pride-red bullets */
    }

    /* Links */
    .prose a {
      color: #c8102e;
      font-weight: 600;
      text-decoration: none;
    }
    .prose a:hover {
      text-decoration: underline;
    }
  </style>
</BaseLayout>