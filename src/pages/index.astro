---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.vue";
import Gallery from "../components/Gallery.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
//import heroBg from "../assets/mega-highway-pride-concrete-can-lift-everything.jpg";
import heroBg from "../assets/work/church-parking-lot.jpeg";
import logo from "../assets/logo.png";
import fallenCurb from "../assets/work/fallen_curb.jpg";
import raisedCurb from "../assets/work/raised_curb.jpg";
import crossSection from "../assets/work/cross_section_concrete_and_foam.jpg";
import alleyBefore from "../assets/work/alley2_before.jpg";
import alleyAfter from "../assets/work/alley2_after.jpg";
import ncfiLogo from "../assets/NCFI/NCFI GEo DB R.png";
import ncfiStep1 from "../assets/NCFI/1st step slab lift graphic.png";
import ncfiStep2 from "../assets/NCFI/2nd step slab lift graphic.png";
import ncfiStep3 from "../assets/NCFI/3rd step slab lift graphic.png";
import prideTruck from "../assets/gallery/pride-truck-logans-roadhouse.jpeg";

const galleryFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpeg,jpg,png,gif}', { eager: true });
const homeGalleryImages = Object.values(galleryFiles).map((file) => file.default);
const heroStyle = `background-image: url('${heroBg.src}');`;

const locations = await getCollection('locations', ({ data }) => {
  if (import.meta.env.PROD) {
    return data.draft !== true;
  }
  return true;
});
locations.sort((a, b) => a.data.city.localeCompare(b.data.city));

const homeFaqItems = [
  { question: "How long have you been doing this?", answer: "We've been lifting and stabilizing concrete for nearly 30 years. Before starting Pride Concrete Lifting, our team spent almost two decades traveling the country repairing concrete roads, bridges, and highways for city and state agencies using polyurethane injection." },
  { question: "How much does concrete lifting cost?", answer: "It depends on the size of the job and how much settling has occurred, but concrete lifting is typically a fraction of the cost of tearing out and replacing. A standard residential driveway usually runs between $1,200 and $3,500. Compare that to a full replacement, which can easily cost $10,000 or more. We provide a free inspection and quote." },
  { question: "How long does the repair take? When can I use the surface?", answer: "Most jobs are completed in a single day, and the surface is usable immediately when we're done. No waiting days for concrete to cure." },
  { question: "Will you tear up my yard or driveway?", answer: "No. We drill a small 5/8 inch hole to inject the polyurethane beneath the slab into the soil. When we're done, we fill the holes with concrete grout. No heavy equipment, no jackhammers, and no mess." },
  { question: "Is the foam safe? Is it toxic?", answer: "The material is non-toxic and non-hazardous to the ground. It's safe around your family, pets, and landscaping. Once cured, it's completely inert — just solid, waterproof support underneath your concrete." },
  { question: "How long does the repair last?", answer: "If the underlying problem that caused the settling is addressed properly before we void-fill, lift, and stabilize the area, the repair can last the lifetime of the pavement." },
  { question: "When is it too far gone to lift?", answer: "If a repair site has been neglected for a long time and the concrete has broken into many small pieces, we'll recommend a traditional tear-out and replacement. We do a physical inspection on-site and walk you through what solution makes the most sense." },
  { question: "Do you work year-round?", answer: "Yes. We work year-round in any conditions. In the winter months, we keep our materials heated so there's never a bad time to get the work done." },
];
---

<BaseLayout
  title="Concrete Lifting & Leveling | Dallas-Fort Worth, TX"
  description="Pride Concrete Lifting has been raising and stabilizing concrete across Dallas-Fort Worth for nearly 30 years. Driveways, sidewalks, pool decks, and more. Free estimates."
  isHomepage={true}
  ogImage={logo.src}
  structuredDataType="business"
  faqItems={homeFaqItems}
>
  <div class="bg-white">
    <section class="relative flex items-center min-h-screen bg-cover bg-center bg-no-repeat" style={heroStyle}>
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/35 to-black/60"
      >
      </div>
      <div
        class="container relative px-6 py-32 mx-auto max-w-7xl lg:px-8 md:pt-40"
      >
        <div class="flex flex-col w-full mb-12 text-center">
          <h1
            class="mb-8 text-5xl font-extrabold tracking-tight text-white md:text-7xl lg:text-7xl"
          >
            Concrete Lifting
            <br class="hidden lg:block" />
            & Soil Stabilization
            <span class="block mt-4 text-2xl font-medium text-gray-200 md:text-3xl tracking-normal">
                Serving Dallas, Fort Worth & All of North Texas
            </span>
          </h1>
          <p
            class="mx-auto text-xl leading-relaxed text-white lg:w-2/3 max-w-4xl"
          >
            We've been lifting and leveling concrete across the DFW metroplex for nearly 30 years.
            From sunken driveways in Weatherford to trip hazards in Plano, garage floors in Aledo
            to warehouse slabs in Fort Worth — we bring the experience, the equipment, and the
            honest pricing to get the job done right.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#contact"
            class="group inline-flex items-center px-6 py-4 text-lg font-semibold text-white transition-colors duration-200 bg-pride-red hover:bg-red-700 focus:ring-4 focus:ring-red-300 focus:outline-none"
          >
            <Icon
              name="fa-solid:paper-plane"
              class="w-6 h-6"
            />
            <span class="flex flex-col items-start ml-4 leading-tight">
              <span class="text-sm text-white/90">FREE ESTIMATES</span>
              <span class="text-white">Send Us A Message</span>
            </span>
          </a>
          <a
            href="tel:817-888-6254"
            class="inline-flex items-center px-6 py-4 text-lg font-bold text-white border-2 border-white hover:bg-white hover:text-navy-900 transition-colors duration-200 md:hidden"
          >
            <Icon name="fa-solid:phone" class="w-5 h-5 mr-2" />
            Call 817-888-6254
          </a>
        </div>
      </div>
    </section>

    <section class="py-6 bg-navy-900">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
          <div class="flex items-center gap-4 py-2">
            <Icon name="fa-solid:calendar-check" class="w-8 h-8 text-pride-red flex-shrink-0" />
            <div>
              <span class="block text-2xl font-bold text-white">30 Years</span>
              <span class="text-sm text-gray-400 uppercase tracking-wider">In the Business</span>
            </div>
          </div>
          <div class="flex items-center gap-4 py-2">
            <Icon name="fa-solid:file-invoice-dollar" class="w-8 h-8 text-pride-red flex-shrink-0" />
            <div>
              <span class="block text-2xl font-bold text-white">Free</span>
              <span class="text-sm text-gray-400 uppercase tracking-wider">Estimates</span>
            </div>
          </div>
          <div class="flex items-center gap-4 py-2">
            <Icon name="fa-solid:clock" class="w-8 h-8 text-pride-red flex-shrink-0" />
            <div>
              <span class="block text-2xl font-bold text-white">Same Day</span>
              <span class="text-sm text-gray-400 uppercase tracking-wider">Results</span>
            </div>
          </div>
          <div class="flex items-center gap-4 py-2">
            <Icon name="fa-solid:shield-alt" class="w-8 h-8 text-pride-red flex-shrink-0" />
            <div>
              <span class="block text-2xl font-bold text-white">Licensed</span>
              <span class="text-sm text-gray-400 uppercase tracking-wider">& Insured</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="grid gap-12 items-center mb-12 mx-auto max-w-6xl lg:grid-cols-2">
          <div>
            <h2
              id="about"
              class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl"
            >
              Nearly 30 Years of Lifting Concrete Across Texas
            </h2>

            <p class="mb-4 text-lg leading-relaxed text-gray-800">
              When you've been doing this as long as we have, you learn what works and what doesn't.
              We combine time-tested methods with today's best technology — high-density polyurethane
              foam injection — to lift and stabilize concrete faster, cleaner, and at a fraction of the
              cost of tearing it out and starting over.
            </p>
            <p class="text-lg leading-relaxed text-gray-800">
              No heavy equipment tearing up your yard, no weeks of waiting for concrete to cure.
              Just a level slab, honest pricing, and a job done right — the way we've been doing it
              since day one.
            </p>
          </div>
          <div>
            <Image
              class="w-full"
              src={prideTruck}
              alt="Pride Concrete Lifting truck on a commercial job site"
            />
          </div>
        </div>

        <div class="grid gap-8 md:grid-cols-2 max-w-6xl mx-auto">
          <div class="relative">
            <div class="absolute top-4 left-4 z-10 px-4 py-1 text-sm font-bold tracking-wider text-white uppercase bg-navy-900">
              Before
            </div>
            <Image
              class="w-full"
              src={fallenCurb}
              alt="Sunken sidewalk curb before concrete lifting"
            />
          </div>
          <div class="relative">
            <div class="absolute top-4 left-4 z-10 px-4 py-1 text-sm font-bold tracking-wider text-white uppercase bg-pride-red">
              After
            </div>
            <Image
              class="w-full"
              src={raisedCurb}
              alt="Sidewalk curb raised and level after concrete lifting"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mx-auto mb-10 max-w-5xl">
          <h2
            id="services"
            class="mb-4 text-4xl font-bold text-center text-navy-900"
          >
            If It's Concrete, We Can Lift It
          </h2>

          <p class="mb-8 text-lg leading-relaxed text-gray-800">
            Your home sits on it, your driveway is poured with it, the roads
            you drive on and the sidewalks you walk on — even the airport
            runways that land commercial jets. Concrete is everywhere, and when
            it sinks, we're the ones who raise it back up. Residential,
            commercial, or municipal — we've done it all across North Texas.
          </p>
          <p class="py-4 text-2xl font-bold text-navy-900 text-center">
            Level Concrete Isn't Just About Looks — It's About Safety.
          </p>
          <p class="mt-8 text-lg leading-relaxed text-gray-800">
            North Texas soil doesn't do concrete any favors. The clay expands, contracts,
            erodes, and washes away — and when the support under a slab is gone, gravity
            does the rest. We lift it back where it belongs and stabilize the soil
            underneath so it stays there.
          </p>
        </div>

        <div class="grid gap-12 items-center mx-auto max-w-6xl lg:grid-cols-2">
          <div class="space-y-6">
            <h3 class="text-3xl font-bold text-navy-900">
              Fix It for a Fraction of the Cost of Replacing It
            </h3>
            <p class="text-lg leading-relaxed text-gray-800">
              Tearing out and repouring concrete is expensive, messy, and takes days.
              Our polyurethane foam injection process lifts and stabilizes your slab in
              hours — typically at 50-70% less than replacement cost. When we leave,
              the surface is ready to use immediately. No curing time, no waiting around.
            </p>
            <div class="space-y-4">
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Driveways, Sidewalks, Patios, and Pool Decks</span
                >
              </div>
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Highways, Streets, Bridges</span
                >
              </div>
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Airport Runways, Racetracks, Bulkheads and Seawalls</span
                >
              </div>
            </div>
          </div>
          <div>
            <Image
              class="w-full border border-gray-200"
              alt="Cross Section Showing Void Filled"
              src={crossSection}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl">
            Standing Water? That's More Than a Nuisance
          </h2>

          <p class="mx-auto text-xl leading-relaxed text-gray-800 max-w-5xl">
            When concrete settles, it creates low spots where water pools instead of draining.
            Those puddles aren't just ugly — they're breeding grounds for mosquitoes and they
            accelerate the damage to your slab. We level the concrete to restore proper
            drainage and eliminate the standing water for good.
          </p>
        </div>

        <div class="grid gap-8 mb-12 mx-auto max-w-6xl md:grid-cols-2">
          <div class="relative">
            <div class="absolute top-4 left-4 z-10 px-4 py-1 text-sm font-bold tracking-wider text-white uppercase bg-navy-900">
              Before
            </div>
            <Image
              class="w-full"
              src={alleyBefore}
              alt="Standing water pooling in alleyway from settled concrete"
            />
          </div>
          <div class="relative">
            <div class="absolute top-4 left-4 z-10 px-4 py-1 text-sm font-bold tracking-wider text-white uppercase bg-pride-red">
              After
            </div>
            <Image
              class="w-full"
              src={alleyAfter}
              alt="Alleyway draining properly after concrete lifting"
            />
          </div>
        </div>

      </div>
    </section>

    <section class="py-12 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-10 text-center">
          <h2
            id="how-it-works"
            class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl"
          >
            Want to See How It Works?
          </h2>

          <p class="text-2xl font-semibold tracking-wide text-gray-500">
            Minimally Invasive. Quick. Effective.
          </p>
        </div>

        <div
          class="grid gap-12 items-center mb-10 mx-auto max-w-6xl md:grid-cols-2"
        >
          <a
            href="https://www.ncfigeo.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-90"
          >
            <Image
              class="w-full"
              src={ncfiLogo}
              alt="NCFI Geotechnical Logo"
            />
          </a>
          <div>
            <p class="text-lg leading-relaxed text-gray-800">
              We use NCFI Geotechnical polyurethane formulations on every job — the
              same industrial-grade foam used on Texas highways and airport runways.
              We drill small holes, inject the foam underneath the slab, and it
              expands to fill every void while gently lifting the concrete back to
              grade. It's waterproof, lightweight, and cures in minutes — not days.
            </p>
          </div>
        </div>

        <div class="grid gap-8 mx-auto max-w-6xl md:grid-cols-3">
          <div class="relative overflow-hidden bg-white border-t-4 border-t-navy-900 border-x border-b border-gray-200">
            <div class="absolute top-4 left-4 z-10 flex items-center justify-center w-10 h-10 text-lg font-bold text-white bg-pride-red">
              1
            </div>
            <div class="overflow-hidden h-80">
              <Image
                alt="Foam Being Injected Under Concrete"
                class="object-cover w-full h-full"
                src={ncfiStep1}
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Foam is Injected
              </h3>
              <p class="leading-relaxed text-gray-800">
                We drill small holes — about the size of a penny — through the
                concrete to reach the soil underneath. No jackhammers, no heavy
                equipment.
              </p>
            </div>
          </div>

          <div class="relative overflow-hidden bg-white border-t-4 border-t-navy-900 border-x border-b border-gray-200">
            <div class="absolute top-4 left-4 z-10 flex items-center justify-center w-10 h-10 text-lg font-bold text-white bg-pride-red">
              2
            </div>
            <div class="overflow-hidden h-80">
              <Image
                alt="Foam Expanding Underneath Concrete"
                class="object-cover w-full h-full"
                src={ncfiStep2}
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Expansion of Foam
              </h3>
              <p class="leading-relaxed text-gray-800">
                High-density polyurethane foam is injected through the ports.
                As it expands, it fills every void underneath and gently raises
                the slab back to level.
              </p>
            </div>
          </div>

          <div class="relative overflow-hidden bg-white border-t-4 border-t-navy-900 border-x border-b border-gray-200">
            <div class="absolute top-4 left-4 z-10 flex items-center justify-center w-10 h-10 text-lg font-bold text-white bg-pride-red">
              3
            </div>
            <div class="overflow-hidden h-80">
              <Image
                alt="Foam Causing Concrete to Lift"
                class="object-cover w-full h-full"
                src={ncfiStep3}
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Lifting and Stabilization
              </h3>
              <p class="leading-relaxed text-gray-800">
                The foam cures to 90% strength in about 15 minutes. The voids
                are filled, the soil is stabilized, and you can walk or drive
                on the surface right away.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {homeGalleryImages.length > 0 && (
      <section class="py-12 bg-white">
        <Gallery images={homeGalleryImages} />
      </section>
    )}

    <section class="py-12 bg-white" id="areas">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl">
            Areas We Serve
          </h2>

          <p class="mx-auto text-xl text-gray-800 max-w-3xl">
            We lift and stabilize concrete across the entire Dallas-Fort Worth metroplex
            and beyond — from Parker County out west to Collin County up north.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 max-w-5xl mx-auto">
          {locations.map(loc => (
            <a
              href={`/locations/${loc.slug}`}
              class="flex items-center p-4 bg-white border border-gray-200 hover:border-navy-900 transition-colors group"
            >
              <Icon name="fa-solid:map-marker-alt" class="w-4 h-4 mr-3 text-pride-red flex-shrink-0" />
              <div>
                <span class="font-semibold text-navy-900">{loc.data.city}, TX</span>
                <span class="block text-sm text-gray-500">{loc.data.county} County</span>
              </div>
            </a>
          ))}
        </div>

        <p class="mt-8 text-center text-gray-500">
          Don't see your city? We likely serve your area too —
          <a href="#contact" class="text-navy-900 font-semibold underline hover:text-pride-red">give us a call</a>.
        </p>
      </div>
    </section>

    <section class="py-12 bg-white" id="faq">
      <div class="container px-6 mx-auto max-w-4xl lg:px-8">
        <div class="mb-12 text-center">
          <h2 class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl">
            Common Questions
          </h2>

          <p class="text-xl text-gray-800">
            Straight answers from nearly 30 years of experience
          </p>
        </div>

        <div class="space-y-6" x-data="{ open: null }">
          <div class="border border-gray-200">
            <button @click="open = open === 1 ? null : 1" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">How long have you been doing this?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 1 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 1" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              We've been lifting and stabilizing concrete for nearly 30 years. Before starting Pride Concrete Lifting, our team spent almost two decades traveling the country repairing concrete roads, bridges, and highways for city and state agencies using polyurethane injection. This isn't something we picked up last year — it's what we've done our whole careers.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 2 ? null : 2" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">How much does concrete lifting cost?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 2 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 2" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              It depends on the size of the job and how much settling has occurred, but concrete lifting is typically a fraction of the cost of tearing out and replacing. A standard residential driveway, for example, usually runs between $1,200 and $3,500. Compare that to a full replacement, which can easily cost $10,000 or more. We provide a free inspection and quote so you know exactly what you're looking at.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 3 ? null : 3" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">How long does the repair take? When can I use the surface?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 3 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 3" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              Most jobs are completed in a single day, and the surface is usable immediately when we're done. No waiting days for concrete to cure. You can walk on it, drive on it, and get back to your life the same day.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 4 ? null : 4" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">Will you tear up my yard or driveway?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 4 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 4" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              No. We drill a small 5/8" hole to inject the polyurethane beneath the slab into the soil. When we're done, we fill the holes with concrete grout. There's no heavy equipment tearing up your lawn, no jackhammers, and no mess. Most people can't even tell where we drilled once we've patched the holes.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 5 ? null : 5" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">Is the foam safe? Is it toxic?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 5 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 5" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              The material is non-toxic and non-hazardous to the ground. It's safe around your family, pets, and landscaping. Once cured, it's completely inert — just solid, waterproof support underneath your concrete.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 6 ? null : 6" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">How long does the repair last?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 6 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 6" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              If the underlying problem that caused the settling is addressed properly before we void-fill, lift, and stabilize the area, the repair can last the lifetime of the pavement. We don't just lift the slab — we fix the root cause so you're not calling us back in a few years.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 7 ? null : 7" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">When is it too far gone to lift?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 7 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 7" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              If a repair site has been neglected for a long time and the concrete has broken into many small pieces, we'll recommend a traditional tear-out and replacement. We'd rather give you an honest answer than sell you a repair that won't hold. We do a physical inspection on-site and walk you through what solution makes the most sense for your situation.
            </div>
          </div>

          <div class="border border-gray-200">
            <button @click="open = open === 8 ? null : 8" class="flex items-center justify-between w-full px-6 py-4 text-left">
              <span class="text-lg font-semibold text-navy-900">Do you work year-round?</span>
              <Icon name="fa-solid:chevron-down" class="w-4 h-4 text-gray-400 transition-transform" x-bind:class="open === 8 ? 'rotate-180' : ''" />
            </button>
            <div x-show="open === 8" x-transition class="px-6 pb-4 text-gray-800 leading-relaxed">
              Yes. We work year-round in any conditions. In the winter months, we keep our materials heated so there's never a bad time to get the work done. Our call volume stays consistent throughout the year because Texas soil and weather don't take a break — and neither do we.
            </div>
          </div>
        </div>
      </div>
    </section>

