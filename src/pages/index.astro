---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.vue";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title="Pride Concrete Lifting and Repair in Dallas / Fort Worth"
  description="Professional concrete lifting and soil stabilization in DFW. 25+ years experience. Free estimates on driveways, patios, sidewalks, and more."
  isHomepage={true}
  keywords="concrete lifting Dallas, concrete leveling Fort Worth, polyurethane foam injection, slab jacking DFW, mudjacking, concrete repair Texas"
  ogImage="../../assets/logo.png"
  structuredDataType="business"
>
  <div class="bg-white">
    <!-- Hero Section -->
    <section class="relative flex items-center min-h-screen hero-bg">
      <div
        class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/70 to-black/80"
      >
      </div>
      <div
        class="container relative px-6 py-32 mx-auto max-w-7xl lg:px-8 md:pt-40"
      >
        <div class="flex flex-col w-full mb-12 text-center">
          <h1 class="mb-8 text-5xl font-bold tracking-tight text-white md:text-7xl lg:text-6xl">
            Concrete Lifting
            <br class="hidden lg:block" />
            and Soil Stabilization
            <span class="block mt-2 text-2xl font-medium text-gray-200 md:text-3xl">
              Serving Dallas, Fort Worth & North Texas
            </span>
          </h1>
          <p
            class="mx-auto text-xl leading-relaxed text-white lg:w-2/3 max-w-4xl"
          >
            We take pride in being able to deliver superior results in our
            concrete lifting and soil stabilization work. Our team has over 25
            years of experience in the concrete lifting industry, and we bring
            all of that knowledge with us when we come to do the job.
          </p>
        </div>

        <div class="flex justify-center">
          <a href="#contact">
            <button
              class="group inline-flex items-center px-6 py-4 text-lg font-semibold text-white transition-all duration-500 ease-in-out transform bg-pride-red rounded-lg shadow-xl hover:bg-red-700 hover:scale-105 focus:ring-4 focus:ring-red-300 focus:outline-none"
            >
              <Icon
                name="fa-solid:paper-plane"
                class="w-6 h-6 transition-transform duration-500 group-hover:scale-125"
              />
              <span class="flex flex-col items-start ml-4 leading-tight">
                <span class="text-sm text-white">FREE ESTIMATES</span>
                <span class="text-white">Send Us A Message</span>
              </span>
            </button>
          </a>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="py-20 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-16 text-center">
          <img
            class="mx-auto mb-12 w-80"
            src="../../assets/logo.png"
            alt="Pride Concrete Lifting - We Take Pride in our Work and our Experience."
          />
          <h2
            id="about"
            class="mb-6 text-4xl font-bold text-navy-900 lg:text-5xl"
          >
            Professional Concrete Lifting and Stabilization Using Time-Tested
            Industry Standards
          </h2>
          <p
            class="mx-auto mt-6 text-xl leading-relaxed text-gray-600 max-w-5xl"
          >
            We've been Lifting and Leveling concrete for a long time, and with
            that experience we're able to employ tried and true methods
            alongside today's more efficient technology to get the job done
            quicker, safer, and cheaper - with no loss of the quality that we
            pride ourselves on.
          </p>
        </div>

        <div class="grid gap-8 md:grid-cols-2 max-w-6xl mx-auto">
          <div class="space-y-4">
            <h3 class="text-3xl font-bold text-navy-900">We Turn This...</h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/fallen_curb.jpg"
              alt="Fallen Sidewalk Curb"
            />
          </div>
          <div class="space-y-4">
            <h3 class="text-3xl font-bold text-navy-900">Into This...</h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/raised_curb.jpg"
              alt="Sidewalk Curb Now Raised"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-20 bg-gray-50">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mx-auto mb-16 max-w-5xl">
          <h2
            id="services"
            class="mb-6 text-4xl font-bold text-center text-navy-900"
          >
            We Work Where the Concrete Is
          </h2>
          <p class="mb-8 text-lg leading-relaxed text-gray-600">
            Concrete is everywhere - Your home is built on top of it, your
            driveway was poured with it, the roads you drive on and the
            sidewalks you walk on, even the airport runways commercial airlines
            rely on for a safe landing!
          </p>
          <div class="p-8 rounded-xl bg-navy-900 shadow-xl">
            <p
              class="text-3xl font-bold text-center text-white leading-relaxed"
            >
              Stable and Level Concrete is Critical to the Safety of our
              Infrastructure
            </p>
          </div>
          <p class="mt-8 text-lg leading-relaxed text-gray-600">
            We depend on the concrete to hold us up, but over time soil erosion
            and constant pressure causes that concrete to sink, and that's where
            we come in to lift that concrete back to its proper place and
            stabilize it for the future.
          </p>
        </div>

        <div class="grid gap-8 mb-16 md:grid-cols-2">
          <div class="hidden md:block">
            <div
              class="w-full h-full rounded-lg shadow-xl poolside-bg min-h-[400px]"
            >
            </div>
          </div>
          <div class="space-y-8">
            <a href="/services/roadways" class="block group">
              <div class="relative overflow-hidden rounded-lg shadow-xl">
                <img class="w-full transition-transform duration-500 group-hover:scale-105"
                    src="../../assets/markets/airport-gallery-image.jpg"
                    alt="Airport Runway Repair" />
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="text-white font-bold text-xl">Commercial & Municipal</span>
                </div>
              </div>
            </a>

            <a href="/services/driveways" class="block group">
              <div class="relative overflow-hidden rounded-lg shadow-xl">
                </div>
            </a>
          </div>
        </div>

        <div class="grid gap-12 items-center mx-auto max-w-6xl lg:grid-cols-2">
          <div class="space-y-6">
            <h3 class="text-3xl font-bold text-navy-900">
              The Cost Effective Way to Level Surfaces and Void-Fill
            </h3>
            <p class="text-lg leading-relaxed text-gray-600">
              Our methods of lifting and void-filling are less invasive and more
              cost-efficient than tearing out and replacing. No waiting on
              concrete to dry or anything to set up - when we leave, the area is
              immediately ready for use.
            </p>
            <div class="space-y-4">
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 rounded-full bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Driveways, Sidewalks, Patios, and Pool Decks</span
                >
              </div>
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 rounded-full bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Highways, Streets, Bridges</span
                >
              </div>
              <div class="flex items-start">
                <span
                  class="flex-shrink-0 flex items-center justify-center w-8 h-8 mt-1 mr-4 rounded-full bg-pride-red"
                >
                  <Icon name="fa-solid:check" class="w-4 h-4 text-white" />
                </span>
                <span class="text-lg text-gray-700"
                  >Airport Runways, Racetracks, Bulkheads and Seawalls</span
                >
              </div>
            </div>
          </div>
          <div>
            <img
              class="w-full rounded-lg shadow-xl"
              alt="Cross Section Showing Void Filled"
              src="../../assets/work/cross_section_concrete_and_foam.jpg"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Drainage Section -->
    <section class="py-20 bg-white">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-16 text-center">
          <h2 class="mb-6 text-4xl font-bold text-navy-900 lg:text-5xl">
            Stagnant Water Got You Itching?
          </h2>
          <p class="mx-auto text-xl leading-relaxed text-gray-600 max-w-5xl">
            Over time, as concrete settles water can form "bird baths" and not
            drain properly. While the birds may enjoy a place to swim, these
            standing puddles of water are the perfect breeding ground for
            mosquitoes and a chance for disease to spread.
          </p>
        </div>

        <div class="grid gap-8 mb-12 mx-auto max-w-6xl md:grid-cols-2">
          <div class="space-y-4">
            <h3 class="text-2xl font-bold text-center text-navy-900">
              Standing Water Before
            </h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/alley2_before.jpg"
              alt="Standing Water in an Alleyway"
            />
          </div>
          <div class="space-y-4">
            <h3 class="text-2xl font-bold text-center text-navy-900">
              Water Draining After
            </h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/alley2_after.jpg"
              alt="Water-Free Alleyway After Concrete Lifting"
            />
          </div>
        </div>

        <div class="grid gap-8 mx-auto max-w-6xl md:grid-cols-2">
          <div class="space-y-4">
            <h3 class="text-2xl font-bold text-center text-navy-900">
              Non-Draining Water
            </h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/standing-water.jpg"
              alt="Non-Draining Water in an Alley"
            />
          </div>
          <div class="space-y-4">
            <h3 class="text-2xl font-bold text-center text-navy-900">
              Water Draining After Leveling
            </h3>
            <img
              class="w-full rounded-lg shadow-xl"
              src="../../assets/work/drain_runoff_1.jpg"
              alt="Water Flowing Properly After Being Raised"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-20 bg-gray-50">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-16 text-center">
          <h2
            id="how-it-works"
            class="mb-4 text-4xl font-bold text-navy-900 lg:text-5xl"
          >
            Want to See How It Works?
          </h2>
          <p class="text-2xl font-semibold tracking-wide text-pride-red">
            Minimally Invasive. Quick. Effective.
          </p>
        </div>

        <div
          class="grid gap-12 items-center mb-16 mx-auto max-w-6xl md:grid-cols-2"
        >
          <a
            href="https://www.ncfigeo.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-90"
          >
            <img
              class="w-full"
              src="../../assets/NCFI/NCFI GEo DB R.png"
              alt="NCFI Geotechnical Logo"
            />
          </a>
          <div>
            <p class="text-lg leading-relaxed text-gray-600">
              Pride Concrete Lifting proudly uses NCFI Geotechnical Polyurethane
              Formulations in all of our jobs. To achieve the goal of lifting
              pavement, asphalt, or any other concrete material foundation - we
              inject a polyurethane formulation underneath the material that
              fills any voided space and as the formulation sets up it begins to
              expand to bring the concrete back to grade and filling the voided
              space ensuring long lasting results.
            </p>
          </div>
        </div>

        <div class="grid gap-8 mx-auto max-w-6xl md:grid-cols-3">
          <div
            class="overflow-hidden bg-white rounded-xl shadow-xl transition-shadow hover:shadow-2xl"
          >
            <div class="overflow-hidden h-80">
              <img
                alt="Foam Being Injected Under Concrete"
                class="object-cover w-full h-full"
                src="../../assets/NCFI/1st step slab lift graphic.png"
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Foam is Injected
              </h3>
              <p class="leading-relaxed text-gray-600">
                After assessing the material to be raised, a 1/2" or 5/8" hole
                is drilled to precise depths to gain access to the foundation of
                the affected area.
              </p>
            </div>
          </div>

          <div
            class="overflow-hidden bg-white rounded-xl shadow-xl transition-shadow hover:shadow-2xl"
          >
            <div class="overflow-hidden h-80">
              <img
                alt="Foam Expanding Underneath Concrete"
                class="object-cover w-full h-full"
                src="../../assets/NCFI/2nd step slab lift graphic.png"
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Expansion of Foam
              </h3>
              <p class="leading-relaxed text-gray-600">
                A polyurethane foam is then carefully injected into the
                subgrade, that expands and lifts the material back to proper
                grade.
              </p>
            </div>
          </div>

          <div
            class="overflow-hidden bg-white rounded-xl shadow-xl transition-shadow hover:shadow-2xl"
          >
            <div class="overflow-hidden h-80">
              <img
                alt="Foam Causing Concrete to Lift"
                class="object-cover w-full h-full"
                src="../../assets/NCFI/3rd step slab lift graphic.png"
              />
            </div>
            <div class="p-6">
              <h3 class="mb-3 text-2xl font-bold text-navy-900">
                Lifting and Stabilization
              </h3>
              <p class="leading-relaxed text-gray-600">
                Once level has been achieved, the foam will then solidify and
                all voids underneath will be filled, preventing future sinkage
                or damage to the concrete.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-20 bg-navy-900">
      <div class="container px-6 mx-auto max-w-7xl lg:px-8">
        <div class="mb-12 text-center">
          <h2
            id="contact"
            class="mb-4 text-4xl font-bold text-white lg:text-5xl"
          >
            Send Us A Message
          </h2>
          <p class="mb-6 text-xl text-gray-300">
            Let Us Know How We Can Help You
          </p>
          <div class="mx-auto space-y-2 text-lg text-gray-300 max-w-4xl">
            <p>
              Fill out the form below to get in contact with us! We can also be
              reached via email at:
            </p>
            <p class="flex items-center justify-center gap-2 text-xl">
              <Icon name="fa-solid:envelope" class="w-5 h-5 text-pride-red" />
              <span class="font-semibold text-white"
                >contact@prideconcretelifting.com</span
              >
            </p>
            <p class="flex items-center justify-center gap-2 text-xl">
              <Icon name="fa-solid:phone" class="w-5 h-5 text-pride-red" />
              <a href="tel:817-888-6254" class="inline-flex items-center px-6 py-3 mt-4 text-lg font-bold text-white bg-pride-red rounded-full hover:bg-red-700 md:hidden">
                <Icon name="fa-solid:phone" class="w-5 h-5 mr-2" />
                Call 817-888-6254
              </a>
            </p>
          </div>
        </div>

        <ContactForm client:load />
      </div>
    </section>
  </div>

  <style>
    .hero-bg {
      background-image: url("../../assets/mega-highway-pride-concrete-can-lift-everything.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    .poolside-bg {
      background-image: url("../../assets/markets/poolside-gallery-image.jpg");
      background-size: cover;
      background-position: center;
    }
  </style>
</BaseLayout>
