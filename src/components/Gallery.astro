---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  images: ImageMetadata[]; 
}

const { images } = Astro.props;

const imageUrls = images.map(img => img.src);

function deriveAltText(src: string): string {
  const filename = src.split('/').pop()?.split('.')[0] ?? '';
  // Strip hashes added by Astro's asset pipeline (e.g., "_BxK2q1fR")
  const cleaned = filename.replace(/_[A-Za-z0-9]{6,}$/, '');
  return cleaned
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, c => c.toUpperCase())
    .trim() || `Gallery image`;
}
---

<section class="py-12">
  <div class="container px-6 mx-auto max-w-7xl">
    <h2 class="mb-8 text-3xl font-bold text-center text-navy-900">Project Gallery</h2>
    
    <div 
      x-data={`{
        currentImage: 0,
        images: ${JSON.stringify(imageUrls)},
        lightboxOpen: false,
        openLightbox(index) {
          this.currentImage = index;
          this.lightboxOpen = true;
          document.body.style.overflow = 'hidden';
        },
        closeLightbox() {
          this.lightboxOpen = false;
          document.body.style.overflow = 'auto';
        },
        nextImage() {
          this.currentImage = (this.currentImage + 1) % this.images.length;
        },
        prevImage() {
          this.currentImage = (this.currentImage - 1 + this.images.length) % this.images.length;
        }
      }`}
      @keydown.escape.window="closeLightbox()"
      @keydown.arrow-right.window="lightboxOpen && nextImage()"
      @keydown.arrow-left.window="lightboxOpen && prevImage()"
    >
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-6 px-6 md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-6 md:pb-0 md:mx-0 md:px-0 scrollbar-hide">
        {images.map((image, index) => (
          <div
            class="relative group cursor-pointer overflow-hidden aspect-video bg-gray-100 flex-shrink-0 w-[85vw] md:w-auto snap-center border border-gray-200"
            @click={`openLightbox(${index})`}
          >
            <Image
              src={image}
              alt={deriveAltText(image.src)}
              width={600}
              class="absolute inset-0 w-full h-full object-cover"
            />
            
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-200 z-10"></div>
          </div>
        ))}
      </div>

      <div 
        x-show="lightboxOpen" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 z-50 flex items-center justify-center bg-black/90"
        style="display: none;"
        @click="closeLightbox()"
      >
        <button 
          @click="closeLightbox()" 
          class="absolute top-4 right-4 text-white hover:text-pride-red transition-colors z-50"
          aria-label="Close lightbox"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <button 
          @click.stop="prevImage()" 
          class="absolute left-4 text-white hover:text-pride-red transition-colors z-50"
          aria-label="Previous image"
        >
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <div class="max-w-7xl max-h-screen p-4" @click.stop>
          <img 
            :src="images[currentImage]" 
            :alt="'Gallery image ' + (currentImage + 1)"
            class="max-w-full max-h-[90vh] object-contain"
          />
          <p class="text-center text-white mt-4 text-lg">
            <span x-text="currentImage + 1"></span> / <span x-text="images.length"></span>
          </p>
        </div>

        <button 
          @click.stop="nextImage()" 
          class="absolute right-4 text-white hover:text-pride-red transition-colors z-50"
          aria-label="Next image"
        >
          <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Optional: Hide scrollbar for cleaner look */
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
  }
</style>