---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const locations = await getCollection('locations', ({ data }) => {
  if (import.meta.env.PROD) {
    return data.draft !== true;
  }
  return true;
});
locations.sort((a, b) => a.data.city.localeCompare(b.data.city));
---
<footer class="py-12 text-white bg-navy-900 border-t border-gray-800">
    <div class="container px-6 mx-auto max-w-7xl">
        <div class="grid gap-8 mb-8 md:grid-cols-3">
            <div>
                <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-400">Navigation</h3>
                <nav class="flex flex-col space-y-2 text-sm">
                    <a href="/#services" class="transition-colors hover:text-pride-red">Services</a>
                    <a href="/#about" class="transition-colors hover:text-pride-red">About Us</a>
                    <a href="/#how-it-works" class="transition-colors hover:text-pride-red">How It Works</a>
                    <a href="/#faq" class="transition-colors hover:text-pride-red">FAQ</a>
                    <a href="/#contact" class="transition-colors hover:text-pride-red">Contact</a>
                </nav>
            </div>
            <div>
                <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-400">Areas We Serve</h3>
                <div class="grid grid-cols-2 gap-1 text-sm">
                    {locations.map(loc => (
                        <a href={`/locations/${loc.slug}`} class="transition-colors hover:text-pride-red">{loc.data.city}</a>
                    ))}
                </div>
            </div>
            <div>
                <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-gray-400">Contact</h3>
                <div class="flex flex-col space-y-3 text-sm">
                    <a href="tel:817-888-6254" class="flex items-center gap-2 transition-colors hover:text-pride-red">
                        <Icon name="fa-solid:phone" class="w-4 h-4 text-pride-red" />
                        817-888-6254
                    </a>
                    <a href="mailto:contact@prideconcretelifting.com" class="flex items-center gap-2 transition-colors hover:text-pride-red">
                        <Icon name="fa-solid:envelope" class="w-4 h-4 text-pride-red" />
                        contact@prideconcretelifting.com
                    </a>
                </div>
            </div>
        </div>
        <div class="pt-6 text-sm text-center text-gray-400 border-t border-gray-800">
            <p>&copy; {new Date().getFullYear()} Pride Concrete Lifting. All rights reserved.</p>
        </div>
    </div>
</footer>
