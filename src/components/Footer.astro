---
import { Icon } from 'astro-icon/components';
---
<footer class="py-12 text-white bg-navy-900 border-t border-gray-800">
    <div class="container px-6 mx-auto max-w-7xl">
        <div class="flex flex-col items-center space-y-6">
            <nav class="flex flex-wrap items-center justify-center text-base">
                <a href="/#services" class="px-4 py-2 transition-colors hover:text-pride-red">Services</a>
                <a href="/#about" class="px-4 py-2 transition-colors hover:text-pride-red">About Us</a>
                <a href="/#how-it-works" class="px-4 py-2 transition-colors hover:text-pride-red">How It Works</a>
                <a href="/#contact" class="px-4 py-2 transition-colors hover:text-pride-red">Contact</a>
            </nav>
            <div class="flex items-center justify-center w-full space-x-2">
                <a href="https://www.facebook.com/REDACTED/" class="flex items-center gap-2 text-gray-400 transition-colors hover:text-pride-red">
                    <Icon name="fa-brands:facebook-square" class="w-6 h-6" />
                    <span>Visit Us On Facebook</span>
                </a>
            </div>
            <div class="pt-4 text-sm text-center text-gray-400 border-t border-gray-800">
                <p>&copy; {new Date().getFullYear()} Pride Concrete Lifting. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>