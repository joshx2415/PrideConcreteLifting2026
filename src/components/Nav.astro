---
import PrimaryLogo from './PrimaryLogo.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const { isHomepage = false } = Astro.props;
const rootPath = isHomepage ? "" : "/";

// LOGIC: Filter out drafts in Production
const services = await getCollection('services', ({ data }) => {
  if (import.meta.env.PROD) {
      return data.draft !== true;
  }
  return true; 
});
services.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<header
  x-data={`{ 
    isOpen: false, 
    scrolled: false, 
    lastScrollPosition: 0,
    isHomepage: ${isHomepage},
    init() {
      window.addEventListener('scroll', () => {
        const cur = window.pageYOffset;
        this.scrolled = cur > 20;
        this.lastScrollPosition = cur;
      });
    }
  }`}
  x-effect="document.body.style.overflow = isOpen ? 'hidden' : 'auto'"
>
  <div 
    class="fixed top-0 w-full z-40 transition-all duration-300"
    :class="(scrolled || !isHomepage) ? 'bg-navy-900 shadow-lg py-2' : 'bg-black/20 backdrop-blur-md py-4'"
  >
    <div class="container mx-auto px-4 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-3 items-center">
        
        <a href="/" class="justify-self-start relative z-50 transition-all duration-300" :class="(scrolled || !isHomepage) ? 'scale-90' : 'scale-100'">
          <PrimaryLogo class="h-10 w-auto md:h-12" />
        </a>

        <nav class="hidden lg:flex items-center justify-self-center gap-8">
          <div class="relative group h-full py-2">
            <button class="flex items-center text-sm text-white font-semibold uppercase tracking-wider hover:text-pride-red transition-colors focus:outline-none">
              What We Lift
              <Icon name="fa-solid:chevron-down" class="ml-2 w-3 h-3 transition-transform duration-300 group-hover:-rotate-180" />
            </button>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform origin-top">
              <div class="bg-white overflow-hidden w-64 border border-gray-200">
                <div class="py-2">
                  {services.map((service) => (
                    <a href={`/services/${service.slug}/`} class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 hover:text-pride-red hover:pl-6 transition-all border-b border-gray-100 last:border-0">
                      {service.data.title.split('|')[0].trim()}
                      {service.data.draft && <span class="text-xs text-red-500 ml-2 font-bold">(Draft)</span>}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <a href={`${rootPath}#how-it-works`} class="text-sm text-white font-semibold uppercase tracking-wider hover:text-pride-red transition-colors">How It Works</a>
          <a href={`${rootPath}#areas`} class="text-sm text-white font-semibold uppercase tracking-wider hover:text-pride-red transition-colors">Areas We Serve</a>
          <a href={`${rootPath}#about`} class="text-sm text-white font-semibold uppercase tracking-wider hover:text-pride-red transition-colors">About</a>
        </nav>

        <div class="hidden lg:flex items-center justify-self-end gap-6">
          <a href="tel:817-888-6254" class="flex flex-col items-end text-white group">
            <span class="text-xs text-gray-300 group-hover:text-white transition-colors">Call Us Now</span>
            <span class="font-bold tracking-wide group-hover:text-pride-red transition-colors">817-888-6254</span>
          </a>
          <a href={`${rootPath}#contact`} class="bg-pride-red hover:bg-red-700 text-white px-6 py-2.5 font-bold transition-colors duration-200">
            Free Estimate
          </a>
        </div>

        <button
          @click="isOpen = !isOpen"
          class="lg:hidden justify-self-end relative z-50 p-2 text-white focus:outline-none"
          aria-label="Toggle Menu"
        >
          <div class="w-8 h-8 flex flex-col justify-center items-end gap-1.5">
            <span class="block h-0.5 bg-white rounded-full transition-all duration-300" :class="isOpen ? 'w-8 rotate-45 translate-y-2' : 'w-8'"></span>
            <span class="block h-0.5 bg-white rounded-full transition-all duration-300" :class="isOpen ? 'opacity-0' : 'w-6'"></span>
            <span class="block h-0.5 bg-white rounded-full transition-all duration-300" :class="isOpen ? 'w-8 -rotate-45 -translate-y-2' : 'w-8'"></span>
          </div>
        </button>

      </div>
    </div>
  </div>

  <div 
    x-show="isOpen" 
    x-transition.opacity.duration.300ms
    class="fixed inset-0 bg-black/60 z-40 backdrop-blur-sm lg:hidden"
    @click="isOpen = false"
    style="display: none;"
  ></div>

  <aside
    class="fixed top-0 left-0 h-full w-80 bg-navy-900 z-50 transform transition-transform duration-300 ease-in-out lg:hidden shadow-lg flex flex-col border-r border-white/10"
    :class="isOpen ? 'translate-x-0' : '-translate-x-full'"
  >
      <div class="p-6 border-b border-white/10 flex items-center justify-between">
         <PrimaryLogo class="h-8 w-auto object-contain" />
         <button @click="isOpen = false" class="text-gray-400 hover:text-white transition-colors focus:outline-none">
            <Icon name="fa-solid:times" class="w-6 h-6" />
         </button>
      </div>

      <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-2">
        <a @click="isOpen = false" href={`${rootPath}#how-it-works`} class="flex items-center p-3 text-gray-300 hover:bg-white/5 hover:text-white rounded transition-colors">
          <Icon name="fa-solid:project-diagram" class="w-5 h-5 mr-3 text-pride-red" />
          How It Works
        </a>
        <a @click="isOpen = false" href={`${rootPath}#about`} class="flex items-center p-3 text-gray-300 hover:bg-white/5 hover:text-white rounded transition-colors">
          <Icon name="fa-solid:id-card" class="w-5 h-5 mr-3 text-pride-red" />
          About Us
        </a>
        <a @click="isOpen = false" href={`${rootPath}#areas`} class="flex items-center p-3 text-gray-300 hover:bg-white/5 hover:text-white rounded transition-colors">
          <Icon name="fa-solid:map-marker-alt" class="w-5 h-5 mr-3 text-pride-red" />
          Areas We Serve
        </a>
        <a @click="isOpen = false" href={`${rootPath}#contact`} class="flex items-center p-3 text-gray-300 hover:bg-white/5 hover:text-white rounded transition-colors">
          <Icon name="fa-solid:envelope" class="w-5 h-5 mr-3 text-pride-red" />
          Contact
        </a>

        <div class="pt-6 mt-4 border-t border-white/10">
          <p class="px-3 text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Services</p>
          {services.map((service) => (
            <a @click="isOpen = false"
               href={`/services/${service.slug}/`}
               class="flex items-center p-3 text-gray-300 hover:bg-white/5 hover:text-white rounded transition-colors pl-8 border-l-2 border-transparent hover:border-pride-red"
            >
              {service.data.title.split('|')[0].trim()}
              {service.data.draft && <span class="text-xs text-red-500 ml-2">(Draft)</span>}
            </a>
          ))}
        </div>
      </nav>

      <div class="p-6 bg-black/20 space-y-4">
        <a href={`${rootPath}#contact`} @click="isOpen = false" class="block w-full bg-pride-red text-white text-center py-3 font-bold hover:bg-red-700 transition-colors">
          Get Free Estimate
        </a>
        <div class="flex flex-col gap-2 text-sm text-gray-400">
           <a href="tel:817-888-6254" class="flex items-center hover:text-white transition-colors">
             <Icon name="fa-solid:phone" class="w-4 h-4 mr-3" /> 817-888-6254
           </a>
           <a href="mailto:contact@prideconcretelifting.com" class="flex items-center hover:text-white transition-colors">
             <Icon name="fa-solid:envelope" class="w-4 h-4 mr-3" /> contact@pride...
           </a>
        </div>
      </div>
  </aside>
</header>