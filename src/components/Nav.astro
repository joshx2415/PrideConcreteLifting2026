---
import PrimaryLogo from './PrimaryLogo.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const { isHomepage = false } = Astro.props;

const services = await getCollection('services', ({ data }) => {
    return data.title !== undefined;
});
services.sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<header
  x-data={`{ isOpen:false, scrolled:false, showNavbar:true, lastScrollPosition:0, isHomepage: ${isHomepage} }`}
  x-effect="document.body.style.overflow = isOpen ? 'hidden' : 'auto'"
  @scroll.window="if(!isOpen){const cur=window.pageYOffset||document.documentElement.scrollTop;showNavbar=cur<lastScrollPosition;lastScrollPosition=cur;scrolled=window.scrollY>0;}"
  :class="{ 'navbar--hidden': !showNavbar, 'scrolled': scrolled || !isHomepage }"
  class="navbar w-screen fixed px-4 py-2 z-50 grid grid-cols-3 items-center"
>
  <a href="/" class="flex items-center justify-self-start">
    <PrimaryLogo style="height: 44px; max-width: 120px; width: auto;" class="object-fit object-center transition duration-300 ease-in-out" />
  </a>

  <nav class="hidden md:flex items-center justify-self-center gap-1">
    <div class="dropdown group relative">
      <span class="nav-link inline-flex items-center cursor-default">
        Areas of Expertise
        <svg class="fill-current ml-1 h-4 w-4 transition-transform duration-300 group-hover:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
      </span>
      <ul class="dropdown-menu absolute left-0 mt-1 w-44 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-300 bg-navy-900 rounded-md shadow-xl overflow-hidden">
        {services.map((service) => (
          <li>
            <a class="block px-4 py-2 text-sm text-white hover:bg-pride-red transition-colors"
               href={`/services/${service.id}`}>
              {service.data.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a class="nav-link" href="#how-it-works">How It Works</a>
    <a class="nav-link" href="#about">About Us</a>
    <a class="nav-link" href="#contact">Contact</a>
  </nav>

  <div class="hidden lg:flex flex-col text-right text-xs justify-self-end">
    <a class="flex items-center justify-end py-1 text-white/90 hover:text-pride-red transition-colors" href="#contact">
      <Icon name="fa-solid:envelope" class="w-4 h-4 mr-2" />contact@prideconcretelifting.com
    </a>
    <a class="flex items-center justify-end py-1 text-white/90 hover:text-pride-red transition-colors" href="tel:817-888-6254">
      <Icon name="fa-solid:phone" class="w-4 h-4 mr-2" />817-888-6254
    </a>
  </div>

  <button id="burger" :class="isOpen ? 'toggled' : ''" @click="isOpen = !isOpen" aria-label="Open Menu"
    class="md:hidden relative w-8 h-8 flex items-center justify-center justify-self-end z-40">
    <span class="bun"></span>
    <span class="bun bun-bottom"></span>
  </button>

  <div x-show="isOpen" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-black/50 z-30" @click="isOpen = false" style="display: none;"></div>

<aside
  class="fixed top-0 left-0 w-80 h-screen z-[9999] flex flex-col overflow-auto transform transition-transform duration-300 ease-in-out"
  :class="isOpen ? 'translate-x-0' : '-translate-x-full'"
  style="background: linear-gradient(180deg, #001f54 0%, #001240 100%);"
>
    
    <!-- Close button -->
    <button @click="isOpen = false" class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center text-white/70 hover:text-white hover:bg-white/10 rounded-full transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Logo -->
    <div class="p-6 pt-8">
      <PrimaryLogo />
    </div>

    <!-- Navigation -->
    <nav class="flex-1 px-4 py-6 space-y-1 overflow-auto">
      <a @click="isOpen = false" href="/#how-it-works" class="mobile-nav-item">
        <span class="mobile-nav-icon"><Icon name="fa-solid:project-diagram" class="w-5 h-5" /></span>
        <span>How It Works</span>
      </a>
      <a @click="isOpen = false" href="/#about" class="mobile-nav-item">
        <span class="mobile-nav-icon"><Icon name="fa-solid:id-card" class="w-5 h-5" /></span>
        <span>About Us</span>
      </a>
      <a @click="isOpen = false" href="/#contact" class="mobile-nav-item">
        <span class="mobile-nav-icon"><Icon name="fa-solid:paper-plane" class="w-5 h-5" /></span>
        <span>Contact</span>
      </a>
      
      <!-- Expertise Section -->
      <div class="pt-4 mt-4 border-t border-white/10">
        <span class="flex items-center gap-3 px-4 py-2 text-sm font-semibold text-white/50 uppercase tracking-wider">
          <Icon name="fa-solid:tools" class="w-4 h-4" />Areas of Expertise
        </span>
        {services.map((service) => (
          <a @click="isOpen = false"
             href={`/services/${service.id}`}
             class="mobile-nav-item pl-12">
            {service.data.title}
          </a>
        ))}
      </div>
    </nav>

    <!-- Contact Footer -->
    <div class="p-6 mt-auto bg-black/20">
      <p class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-3">Get in Touch</p>
      <a href="mailto:contact@prideconcretelifting.com" class="flex items-center gap-3 py-2 text-sm text-white/80 hover:text-pride-red transition-colors">
        <Icon name="fa-solid:envelope" class="w-4 h-4" />
        contact@prideconcretelifting.com
      </a>
      <a href="tel:817-888-6254" class="flex items-center gap-3 py-2 text-sm text-white/80 hover:text-pride-red transition-colors">
        <Icon name="fa-solid:phone" class="w-4 h-4" />
        817-888-6254
      </a>
    </div>
  </aside>
</header>

<style>
  .navbar {
    transform: translate3d(0, 0, 0);
    transition: all 0.3s ease;
    min-height: 56px;
  }

  .navbar.navbar--hidden {
    transform: translate3d(0, -100%, 0);
    opacity: 0;
  }

  .scrolled {
    background-color: #001f54;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: white;
    transition: color 0.3s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: #c8102e;
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nav-link:hover {
    color: #c8102e;
  }

  .nav-link:hover::after {
    width: 80%;
  }

  .dropdown-menu {
    transform: translateY(-10px);
  }

  .dropdown:hover .dropdown-menu {
    transform: translateY(0);
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: white;
    font-weight: 500;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
  }

  .mobile-nav-item:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #c8102e;
  }

  .mobile-nav-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 0.375rem;
  }

  .mobile-nav-item:hover .mobile-nav-icon {
    background-color: #c8102e;
    color: white;
  }

  .bun {
    position: absolute;
    width: 24px;
    height: 2px;
    background-color: white;
    transition: all 0.3s ease;
    transform: translateY(-4px);
  }

  .bun-bottom {
    transform: translateY(4px);
  }

  .toggled .bun {
    transform: rotate(45deg);
  }

  .toggled .bun-bottom {
    transform: rotate(-45deg);
  }
</style>