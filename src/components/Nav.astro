---
import PrimaryLogo from './PrimaryLogo.astro';
import { Icon } from 'astro-icon/components';
---
<header x-data="{ isOpen: false, scrolled: false, showNavbar: true, lastScrollPosition: 0 }"
  @scroll.window="const currentScrollPosition = window.pageYOffset || document.documentElement.scrollTop; if (currentScrollPosition >= 0) { showNavbar = currentScrollPosition < lastScrollPosition; lastScrollPosition = currentScrollPosition; } scrolled = window.scrollY > 0;"
  :class="{ 'navbar--hidden': !showNavbar, 'scrolled': scrolled }"
  class="navbar w-screen flex items-center fixed px-4 py-2 z-50 body-font justify-between md:justify-between">
  <a href="/" class="flex items-center justify-center">
    <PrimaryLogo style="height: 44px; max-width: 120px; width: auto;" class="object-fit object-center shadow-md mlogo transition duration-500 ease-in-out transform hover:text-pride-red" />
  </a>

  <ul class="hidden md:flex justify-center">
    <li class="dropdown group inline-block relative whitespace-nowrap md:mr-2">
      <span class="transition duration-500 ease-in-out group-hover:bg-white group-hover:text-pride-red text-white text-base font-medium px-4 py-2 mt-2 md:mt-0 inline-flex items-center cursor-default">
        Areas of Expertise
        <svg class="fill-current ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/> </svg>
      </span>
      <ul class="dropdown-menu absolute w-full invisible opacity-0 text-pride-red text-center group-hover:bg-white group-hover:visible group-hover:opacity-100 group-hover:transition-all delay-150 duration-500 ease-in-out">
        <li><a class="bg-white text-base font-medium hover:bg-pride-red hover:text-white py-1 px-3 block whitespace-no-wrap" href="/Driveways">Driveways</a></li>
        <li><a class="bg-white text-base font-medium hover:bg-pride-red hover:text-white py-1 px-3 block whitespace-no-wrap" href="/Pooldecks">Pooldecks</a></li>
      </ul>
    </li>
    <li class="flex justify-center whitespace-nowrap md:mr-2">
      <a class="items-center px-4 py-2 mt-2 text-base font-medium tracking-tight transition duration-500 ease-in-out transform text-white md:mt-0 hover:text-pride-red hover:bg-white" href="#how-it-works">How It Works</a></li>
    <li class="flex justify-center whitespace-nowrap md:mr-2">
      <a class="items-center px-4 py-2 mt-2 text-base font-medium tracking-tight transition duration-500 ease-in-out transform text-white md:mt-0 hover:text-pride-red hover:bg-white" href="#about">About Us</a></li>
    <li class="flex justify-center whitespace-nowrap md:mr-2">
      <a class="items-center px-4 py-2 mt-2 text-base font-medium tracking-tight transition duration-500 ease-in-out transform text-white md:mt-0 hover:text-pride-red hover:bg-white" href="#contact">Contact</a></li>
  </ul>

  <ul class="hidden md:flex flex-col">
    <li><a class="items-center py-2 mt-1 text-sm font-normal tracking-tight text-white lg:mx-4 md:mt-0 md:ml-2" href="#contact"><Icon name="fa-solid:envelope" class="w-5 h-5 mr-2" /> <strong>Send us an Email</strong>: contact@prideconcretelifting.com</a></li>
    <li><a class="items-center py-2 mt-1 text-sm font-normal tracking-tight text-white lg:mx-4 md:mt-0 md:ml-2" href="tel:817-888-6254"><Icon name="fa-solid:phone" class="w-5 h-5 mr-2" /> <strong>Give us a Call</strong>: 817-888-6254</a></li>
  </ul>

    <a id="burger" :class="isOpen ? 'toggled' : ''"
        class="md:hidden flex space-between transition duration-500 ease-in-out transform sm:target-burger"
        @click.prevent="isOpen = !isOpen" aria-label="Open Menu">
        <ul class="buns">
            <li class="bun"></li>
            <li class="bun"></li>
        </ul>
    </a>

    <div x-show="isOpen" class="z-10 h-screen fixed inset-0 transition-opacity" style="display: none;">
        <div @click="isOpen = false" class="absolute inset-0 bg-black opacity-50" tabindex="0"></div>
    </div>

    <aside
        class="transform flex flex-col justify-evenly h-screen top-0 left-0 w-64 bg-navy-900 fixed h-full overflow-auto ease-in-out transition-all duration-300 z-30"
        :class="isOpen ? 'translate-x-0' : '-translate-x-full'">
        <span class="mt-2"><PrimaryLogo /></span>
        <span @click="isOpen = false"
            class="flex mt-4 pt-4 pb-4 align-center font-bold text-lg hover:bg-pride-red text-white transition-colors">
            <a href="/#how-it-works" class="ml-6 w-full flex items-center"><Icon name="fa-solid:project-diagram" class="w-6 h-6 mr-2" />
            How It Works</a>
        </span>
        <span @click="isOpen = false"
            class="flex pt-4 pb-4 align-center font-bold text-lg hover:bg-pride-red text-white transition-colors">
            <a href="/#about" class="ml-6 w-full flex items-center"><Icon name="fa-solid:id-card" class="w-6 h-6 mr-2" />
            About Us</a>
        </span>
        <span @click="isOpen = false"
            class="flex pt-4 pb-4 align-center font-bold text-lg hover:bg-pride-red text-white transition-colors">
            <a href="/#contact" class="ml-6 w-full flex items-center"><Icon name="fa-solid:paper-plane" class="w-6 h-6 mr-2" />
            Contact</a>
        </span>
        <span @click="isOpen = false"
            class="flex pt-4 pb-4 flex-col justify-center font-bold text-lg hover:bg-pride-red text-white transition-colors">
            <span class="flex items-center"><Icon name="fa-solid:tools" class="w-6 h-6 ml-6 mr-2" />Areas of Expertise</span>
            <ul class="w-full opacity-100 text-white group-hover:bg-pride-red group-hover:opacity-100 transition duration-500 ease-in-out">
                <li class=""><a class="text-lg font-medium hover:bg-white hover:text-pride-red py-2 px-4 block whitespace-no-wrap" href="/Driveways"><span class="ml-7">Driveways</span></a></li>
                <li class=""><a class="text-lg font-medium hover:bg-white hover:text-pride-red py-2 px-4 block whitespace-no-wrap" href="/Pooldecks"><span class="ml-7">Pooldecks</span></a></li>
            </ul>
        </span>
        <ul @click="isOpen = false" class="flex flex-col p-4">
            <li><a class="items-center py-3 mt-2 text-base font-normal tracking-tight text-white lg:mx-8 md:mt-0 md:ml-4"
                href="#contact">
                contact@prideconcretelifting.com</a>
            </li>
            <li><a class="items-center py-3 mt-2 text-base font-normal tracking-tight text-white lg:mx-8 md:mt-0 md:ml-4"
                href="tel:817-888-6254">817-888-6254</a></li>
        </ul>
    </aside>

</header>

<style>
  .navbar {
    transform: translate3d(0, 0, 0);
    transition: all .2s ease-in;
    min-height: 56px;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }

  .navbar.navbar--hidden {
    opacity: 0;
    visibility: hidden;
    box-shadow: none;
    transform: translate3d(0, -100%, 0);
    transition: all 400ms;
  }

  .dropdown:hover .dropdown-menu {
    display: block;
    box-shadow: 0px 3px 10px rgba(0, 0, 0, 0.5);
    clip-path: inset(0px -10px -10px -10px);
  }

  button:focus {
    outline: 0;
  }

  .target-burger {
    margin: 0.5em;
    width: 2.5em;
    height: 2.5em;
    display: block;
    transition: all 0.5s ease;
  }

  .target-burger:hover {
    cursor: pointer;
    opacity: 0.45;
  }

  .toggled ul.buns li.bun {
    transform: rotate(45deg) translateZ(0);
  }

  .toggled ul.buns li.bun:last-child {
    transform: rotate(-45deg) translateZ(0);
  }

  .buns {
    width: 1.25em;
    height: 1.25em;
    list-style: none;
    padding: 0;
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1), color 1s cubic-bezier(0.23, 1, 0.32, 1);
    transform: translateZ(0);
    color: #fff;
  }

  .bun {
    width: 100%;
    height: 2px;
    background-color: #fff;
    position: absolute;
    top: 50%;
    margin-top: -0.75px;
    transform: translateY(-3.75px) translateZ(0);
    transition: transform 1s cubic-bezier(0.23, 1, 0.32, 1), background-color 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .bun:last-child {
    transform: translateY(3.75px) translateZ(0);
  }

  .scrolled {
    background-color: #001f54;
    box-shadow: 0px 3px 10px rgba(0, 0, 0, 0.5);
  }
</style>