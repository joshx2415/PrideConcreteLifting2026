---
export interface Props {
  type?: 'business' | 'service';
  title?: string;
  description?: string;
  image?: string;
}

const { type = 'business', title, description, image = '/images/logo.png' } = Astro.props;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Pride Concrete Lifting",
  "image": new URL(image, Astro.site),
  "description": description || "Professional concrete lifting and soil stabilization services in Dallas/Fort Worth with over 25 years of experience.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dallas-Fort Worth",
    "addressRegion": "TX",
    "addressCountry": "US"
  },
  "telephone": "+1-817-888-6254",
  "email": "contact@prideconcretelifting.com",
  "url": Astro.site,
  "priceRange": "$$",
  "serviceArea": {
    "@type": "GeoCircle",
    "geoMidpoint": {
      "@type": "GeoCoordinates",
      "latitude": "32.7767",
      "longitude": "-96.7970"
    },
    "geoRadius": "50"
  },
  "areaServed": [
    { "@type": "City", "name": "Dallas" },
    { "@type": "City", "name": "Fort Worth" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Concrete Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Concrete Lifting",
          "description": "Professional concrete lifting and leveling services"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Soil Stabilization",
          "description": "Expert soil stabilization using polyurethane foam"
        }
      }
    ]
  }
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": title,
  "description": description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Pride Concrete Lifting",
    "telephone": "+1-817-888-6254",
    "email": "contact@prideconcretelifting.com"
  },
  "areaServed": {
    "@type": "State",
    "name": "Texas"
  },
  "serviceType": "Concrete Lifting and Repair"
};

const schema = type === 'service' && title ? serviceSchema : businessSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />